{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/campus/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://claf-staging.centralindia.cloudapp.azure.com/api/:path*"
    }
  ]
}
